{
  "expo": {
    "name": "KAMMO",
    "slug": "kammomobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/kammo-logo.png",
    "userInterfaceStyle": "light",
    "scheme": "kammo",
    "splash": {
      "image": "./assets/kammo-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#030304"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kammo.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/kammo-logo.png",
        "backgroundColor": "#030304"
      },
      "package": "com.kammo.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow KAMMO to scan deal QR codes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiBaseUrl": "http://192.168.1.6:8080"
    }
  }
}
